{
  "name": "whatsapp-mcp-personal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pair": "node src/pair.mjs",
    "start": "node src/server.mjs",
    "test": "node test_allowlist.mjs",
    "postinstall": "bash scripts/setup-voice.sh; bash scripts/setup-text-extract.sh",
    "setup:text": "bash scripts/setup-text-extract.sh",
    "format": "oxfmt src/ scripts/ test_allowlist.mjs",
    "format:check": "oxfmt --check src/ scripts/ test_allowlist.mjs",
    "lint": "oxlint src/ scripts/ test_allowlist.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0"
  }
}
