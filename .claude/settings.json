{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "./memory",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Glob|Grep|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/deny-outside-repo.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__whatsapp-personal__wa_*",
      "Bash(/Users/burak/Desktop/repos/whatsapp-mcp-personal/.claude/skills/meme-tools/scripts/*.py *)",
      "Bash(/Users/burak/Desktop/repos/whatsapp-mcp-personal/.claude/skills/yt-dlp/scripts/*.py *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(yt-dlp *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(./state/auth/**)",
      "Read(./state/messages/**)",
      "Read(./state/archive/**)",
      "Read(./state/messages.db)",
      "Read(./state/messages.db-wal)",
      "Read(./state/messages.db-shm)",
      "Read(./state/contacts.json)",
      "Read(./state/poll-state.json)",
      "Read(./state/*.tgz)"
    ]
  }
}
